// ============================================================================
// 1. ЗАПРОС ДАННЫХ ИЗ РЕГИСТРА / QUERY DATA FROM REGISTER
// ============================================================================

&НаКлиенте
Процедура КнопкаЗапрос(Команда)
    запрос1НаСервере();
КонецПроцедуры

&НаСервере
Процедура запрос1НаСервере()
    
    // Очистка таблицы перед заполнением / Clear table before filling
    Object.ТаблицаЗначений.Очистить();
    
    // Проверка: введены ли обе даты? / Check: are both dates entered?
    Если НЕ ЗначениеЗаполнено(Object.ДатаНачала) 
        ИЛИ НЕ ЗначениеЗаполнено(Object.ДатаОкончания) Тогда
        Сообщить("Введите дату начала и дату окончания");
        Сообщить("Enter start date and end date");
        Возврат;
    КонецЕсли;
    
    // Текст запроса / Query text
    ТекстЗапроса = "
    |ВЫБРАТЬ
    |    демо_АгрегацияКодовМаркировки.ИдентификаторОбмена КАК ИдентификаторОбмена,
    |    демо_АгрегацияКодовМаркировки.КодМаркировки КАК КодМаркировки,
    |    демо_АгрегацияКодовМаркировки.ХешСуммаКодаМаркировки КАК ХешСуммаКодаМаркировки,
    |    демо_АгрегацияКодовМаркировки.ДатаАгрегации КАК ДатаАгрегации,
    |    демо_АгрегацияКодовМаркировки.Линия КАК Линия,
    |    демо_АгрегацияКодовМаркировки.Уровень КАК Уровень,
    |    демо_АгрегацияКодовМаркировки.КодМаркировкиBase64 КАК КодМаркировкиBase64,
    |    демо_АгрегацияКодовМаркировки.КодАгрегации КАК КодАгрегации,
    |    демо_АгрегацияКодовМаркировки.КодАгрегацииBase64 КАК КодАгрегацииBase64
    |ИЗ
    |    РегистрСведений.демо_АгрегацияКодовМаркировки КАК демо_АгрегацияКодовМаркировки
    |ГДЕ
    |    демо_АгрегацияКодовМаркировки.ДатаАгрегации МЕЖДУ &ДатаНачала И &ДатаОкончания
    |";
    
    // Создание и выполнение запроса / Create and execute query
    Запрос = Новый Запрос(ТекстЗапроса);
    Запрос.УстановитьПараметр("ДатаНачала",    Object.ДатаНачала);
    Запрос.УстановитьПараметр("ДатаОкончания", Object.ДатаОкончания);
    
    Выборка = Запрос.Выполнить().Выбрать();
    
    // Заполнение таблицы значений / Fill value table
    Пока Выборка.Следующий() Цикл
        
        НоваяСтрока = Object.ТаблицаЗначений.Добавить();
        
        НоваяСтрока.ИдентификаторОбмена    = Выборка.ИдентификаторОбмена;
        НоваяСтрока.КодМаркировки          = Выборка.КодМаркировки;
        НоваяСтрока.ХешСуммаКодаМаркировки = Выборка.ХешСуммаКодаМаркировки;
        НоваяСтрока.ДатаАгрегации          = Выборка.ДатаАгрегации;
        НоваяСтрока.Линия                  = Выборка.Линия;
        НоваяСтрока.Уровень                = Выборка.Уровень;
        НоваяСтрока.КодМаркировкиBase64    = Выборка.КодМаркировкиBase64;
        НоваяСтрока.КодАгрегации           = Выборка.КодАгрегации;
        НоваяСтрока.КодАгрегацииBase64     = Выборка.КодАгрегацииBase64;
        
    КонецЦикла;
    
    // Сообщение о результате / Result message
    Сообщить("Прочитано строк из базы: " + Object.ТаблицаЗначений.Количество());
    
КонецПроцедуры

// ============================================================================
// 2. ЗАГРУЗКА ДАННЫХ ИЗ EXCEL / LOAD DATA FROM EXCEL
// ============================================================================

&НаКлиенте
Асинх Процедура КнопкаЗагрузитьExcel(Команда)
    
    // Диалог выбора файла / File selection dialog
    ПараметрыДиалога = Новый ПараметрыДиалогаПомещенияФайлов;
    ПараметрыДиалога.Заголовок = "Выберите файл Excel";
    ПараметрыДиалога.Фильтр    = "Таблица Excel | *.xls; *.xlsx";
    
    // Загрузка файла на сервер / Upload file to server
    ОписаниеФайла = Ждать ПоместитьФайлНаСерверАсинх(,,,ПараметрыДиалога);
    
    Если ОписаниеФайла <> Неопределено Тогда
        ПрочитатьExcelНаСервере(ОписаниеФайла.Адрес, ОписаниеФайла.СсылкаНаФайл.Расширение);
    КонецЕсли;
    
КонецПроцедуры

&НаСервере
Процедура ПрочитатьExcelНаСервере(АдресДанных, РасширениеФайла)
    
    // Временный файл / Temporary file
    ПутьКФайлу = ПолучитьИмяВременногоФайла(РасширениеФайла);
    
    // Чтение из временного хранилища / Read from temporary storage
    Данные = ПолучитьИзВременногоХранилища(АдресДанных);
    Данные.Записать(ПутьКФайлу);
    
    // Парсинг Excel / Parse Excel
    ПрочитатьExcel_ТабличныйДокумент(ПутьКФайлу);
    
    // Удаление временного файла / Delete temporary file
    УдалитьФайлы(ПутьКФайлу);
    
    Сообщить("Чтение файла Excel завершено / Excel file reading completed");
    
КонецПроцедуры

Процедура ПрочитатьExcel_ТабличныйДокумент(ПутьКФайлу)
    
    // Очистка таблицы / Clear table
    Object.ТаблицаЗначений.Очистить();
    
    ТабличныйДокумент = Новый ТабличныйДокумент;
    
    // Попытка чтения файла / Try to read file
    Попытка
        ТабличныйДокумент.Прочитать(ПутьКФайлу);
    Исключение
        Сообщить("Не удалось прочитать файл: " + ОписаниеОшибки());
        Возврат;
    КонецПопытки;
    
    КоличествоСтрок = ТабличныйДокумент.ВысотаТаблицы;
    
    // Чтение строк начиная со 2-й (1-я = заголовок)
    // Read rows starting from 2nd (1st = header)
    Для НомерСтроки = 2 По КоличествоСтрок Цикл
        
        СтрокаТаблицы = Object.ТаблицаЗначений.Добавить();
        
        СтрокаТаблицы.ИдентификаторОбмена    = ТабличныйДокумент.Область(НомерСтроки, 1).Текст;
        СтрокаТаблицы.КодМаркировки          = ТабличныйДокумент.Область(НомерСтроки, 2).Текст;
        СтрокаТаблицы.ХешСуммаКодаМаркировки = ТабличныйДокумент.Область(НомерСтроки, 3).Текст;
        СтрокаТаблицы.ДатаАгрегации          = ПреобразоватьВДату(ТабличныйДокумент.Область(НомерСтроки, 4).Текст);
        СтрокаТаблицы.Линия                  = ПреобразоватьВЧисло(ТабличныйДокумент.Область(НомерСтроки, 5).Текст);
        СтрокаТаблицы.Уровень                = ПреобразоватьВЧисло(ТабличныйДокумент.Область(НомерСтроки, 6).Текст);
        СтрокаТаблицы.КодМаркировкиBase64    = ТабличныйДокумент.Область(НомерСтроки, 7).Текст;
        СтрокаТаблицы.КодАгрегации           = ТабличныйДокумент.Область(НомерСтроки, 8).Текст;
        СтрокаТаблицы.КодАгрегацииBase64     = ТабличныйДокумент.Область(НомерСтроки, 9).Текст;
        
    КонецЦикла;
    
    Сообщить("Прочитано строк из Excel: " + (КоличествоСтрок - 1));
    
КонецПроцедуры

// ============================================================================
// 3. ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ / HELPER FUNCTIONS
// ============================================================================

// Преобразование текста в дату / Convert text to date
// Поддерживаемые форматы: ДД.ММ.ГГГГ, ДД/ММ/ГГГГ
// Supported formats: DD.MM.YYYY, DD/MM/YYYY
Функция ПреобразоватьВДату(Текст)
    
    Если ПустаяСтрока(Текст) Тогда
        Возврат '00010101';
    КонецЕсли;
    
    // Нормализация разделителей / Normalize separators
    НормализованныйТекст = СтрЗаменить(Текст, "/", ".");
    Части = СтрРазделить(НормализованныйТекст, ".");
    
    Если Части.Количество() = 3 Тогда
        День  = Число(Части[0]);
        Месяц = Число(Части[1]);
        Год   = Число(Части[2]);
        
        Если День > 0 И Месяц > 0 И Год > 0 Тогда
            Попытка
                Возврат Дата(Год, Месяц, День);
            Исключение
                Возврат '00010101';
            КонецПопытки;
        КонецЕсли;
    КонецЕсли;
    
    Возврат '00010101';
    
КонецФункции

// Преобразование текста в число / Convert text to number
Функция ПреобразоватьВЧисло(Текст)
    
    Если ПустаяСтрока(Текст) Тогда
        Возврат 0;
    КонецЕсли;
    
    Попытка
        Возврат Число(СтрЗаменить(Текст, ",", "."));
    Исключение
        Возврат 0;
    КонецПопытки;
    
КонецФункции

// ============================================================================
// 4. ЗАПИСЬ ДАННЫХ В РЕГИСТР / WRITE DATA TO REGISTER
// ============================================================================

&НаКлиенте
Процедура КнопкаЗаписать(Команда)
    записатьНаСервере();
КонецПроцедуры

&НаСервере
Процедура записатьНаСервере()
    
    // Проверка: есть ли данные? / Check: is there data?
    Если Object.ТаблицаЗначений.Количество() = 0 Тогда
        Сообщить("Нет данных для записи / No data to write");
        Возврат;
    КонецЕсли;
    
    // Создание набора записей / Create record set
    НаборЗаписей = РегистрыСведений.демо_АгрегацияКодовМаркировки.СоздатьНаборЗаписей();
    
    Для Каждого СтрокаТЗ Из Object.ТаблицаЗначений Цикл
        
        НоваяЗапись = НаборЗаписей.Добавить();
        
        НоваяЗапись.КодМаркировки          = СтрокаТЗ.КодМаркировки;
        НоваяЗапись.ХешСуммаКодаМаркировки = СтрокаТЗ.ХешСуммаКодаМаркировки;
        НоваяЗапись.КодМаркировкиBase64    = СтрокаТЗ.КодМаркировкиBase64;
        НоваяЗапись.КодАгрегации           = СтрокаТЗ.КодАгрегации;
        НоваяЗапись.КодАгрегацииBase64     = СтрокаТЗ.КодАгрегацииBase64;
        НоваяЗапись.ИдентификаторОбмена    = СтрокаТЗ.ИдентификаторОбмена;
        НоваяЗапись.ДатаАгрегации          = СтрокаТЗ.ДатаАгрегации;
        НоваяЗапись.Линия                  = СтрокаТЗ.Линия;
        НоваяЗапись.Уровень                = СтрокаТЗ.Уровень;
        
    КонецЦикла;
    
    // Истина = заменить существующие записи / True = replace existing records
    НаборЗаписей.Записать(Истина);
    
    Сообщить("Запись данных завершена. Записано строк: " + Object.ТаблицаЗначений.Количество());
    
КонецПроцедуры
